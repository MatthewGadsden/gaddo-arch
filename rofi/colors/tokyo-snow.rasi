/**
 *
 * tokyo-snow
 * Palette: ~/.config/tokyo-snow.theme (sampled from hypr/gruv-01.jpg)
 *
 **/

* {
    /* full palette, for themes written for tokyo-snow */
    night:          #1C1C1AFF;
    shadow:         #2A2A28FF;
    slate:          #3A3933FF;
    dim:            #7D7860FF;
    snow:           #F1E4B5FF;
    brick:          #96402EFF;
    neon:           #D5583DFF;
    ember:          #DB814CFF;
    amber:          #E1B568FF;
    gold:           #ECD08FFF;
    sage:           #C4C88EFF;
    moss:           #A6D46CFF;
    pine:           #6FC28AFF;

    /* adi1090x names, used by the stock launchers/powermenus/applets */
    background:     #1C1C1AFF;
    background-alt: #2A2A28FF;
    foreground:     #F1E4B5FF;
    selected:       #E1B568FF;
    active:         #C4C88EFF;
    urgent:         #D5583DFF;
}
