/**
 *
 * tokyo-snow launcher
 * Matches waybar/hyprlock: night background, 1px slate border,
 * small rounding, FiraCode bold, amber selection, with the wallpaper's
 * vending machines in a side panel.
 *
 * Colors: ~/.config/rofi/colors/tokyo-snow.rasi
 *
 **/

/*****----- Configuration -----*****/
configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               "󰀻";
    display-run:                "";
    display-filebrowser:        "";
    display-window:             "";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

/*****----- Global Properties -----*****/
@import                          "shared/colors.rasi"

* {
    font:                        "FiraCode Nerd Font Mono Bold 11";
    background-color:            transparent;
    text-color:                  @snow;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       760px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    border:                      1px solid;
    border-radius:               3px;
    border-color:                @slate;
    background-color:            @night;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    orientation:                 horizontal;
    children:                    [ "imagebox", "listbox" ];
}

/* the lit vending machines from the wallpaper (hypr/gruv-01.jpg) */
imagebox {
    width:                       232px;
    border:                      0px 1px 0px 0px;
    border-color:                @slate;
    background-image:            url("~/.config/rofi/images/tokyo-snow.jpg", height);
}

listbox {
    spacing:                     10px;
    padding:                     12px;
    orientation:                 vertical;
    children:                    [ "inputbar", "listview", "mode-switcher" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     8px 12px;
    border:                      0px 0px 1px 0px;
    border-radius:               2px;
    border-color:                @dim;
    background-color:            @shadow;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    text-color:                  @ember;
}
entry {
    enabled:                     true;
    cursor:                      text;
    placeholder:                 "Search…";
    placeholder-color:           @dim;
    text-color:                  @snow;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     2px;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    padding:                     6px 10px;
    border:                      0px 0px 0px 2px;
    border-radius:               2px;
    border-color:                transparent;
    cursor:                      pointer;
}
element normal.normal,
element alternate.normal {
    background-color:            transparent;
    text-color:                  @snow;
}
element normal.urgent,
element alternate.urgent {
    text-color:                  @neon;
}
element normal.active,
element alternate.active {
    text-color:                  @sage;
}
element selected.normal {
    border-color:                @amber;
    background-color:            @slate;
    text-color:                  @amber;
}
element selected.urgent {
    border-color:                @neon;
    background-color:            @slate;
    text-color:                  @neon;
}
element selected.active {
    border-color:                @sage;
    background-color:            @slate;
    text-color:                  @sage;
}
element-icon {
    size:                        22px;
    cursor:                      inherit;
}
element-text {
    vertical-align:              0.5;
    horizontal-align:            0.0;
    text-color:                  inherit;
    cursor:                      inherit;
}

/*****----- Mode Switcher -----*****/
mode-switcher {
    enabled:                     true;
    spacing:                     6px;
}
button {
    padding:                     6px;
    border-radius:               2px;
    background-color:            @shadow;
    text-color:                  @dim;
    cursor:                      pointer;
}
button selected {
    background-color:            @slate;
    text-color:                  @gold;
}

/*****----- Message -----*****/
message {
    enabled:                     true;
    padding:                     8px 12px;
    border-radius:               2px;
    background-color:            @shadow;
}
textbox {
    text-color:                  @gold;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
error-message {
    padding:                     12px;
    border:                      1px solid;
    border-radius:               3px;
    border-color:                @neon;
    background-color:            @night;
    text-color:                  @snow;
}
