{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "brick": "#96402e",
    "neon": "#d5583d",
    "ember": "#db814c",
    "amber": "#e1b568",
    "gold": "#ecd08f",
    "sage": "#c4c88e",
    "moss": "#a6d46c",
    "pine": "#6fc28a",
    "snow": "#f1e4b5",
    "dim": "#7d7860",
    "night": "#1c1c1a",
    "shadow": "#2a2a28",
    "slate": "#3a3933"
  },
  "palettes": {
    "template": "{{ if .Env.TOKYO_SNOW_VARIANT }}{{ .Env.TOKYO_SNOW_VARIANT }}{{ else }}lamplit-glow{{ end }}",
    "list": {
      "lamplit": {
        "brick": "#96402e",
        "neon": "#d5583d",
        "ember": "#db814c",
        "amber": "#e1b568",
        "gold": "#ecd08f",
        "sage": "#c4c88e",
        "moss": "#acbb7f",
        "pine": "#8fa877",
        "snow": "#f1e4b5",
        "dim": "#7d7860",
        "night": "#1c1c1a",
        "shadow": "#2a2a28",
        "slate": "#3a3933"
      },
      "neon-alley": {
        "brick": "#a8341f",
        "neon": "#e8492b",
        "ember": "#f07f3c",
        "amber": "#f2aa4c",
        "gold": "#f4cc72",
        "sage": "#c9d48a",
        "moss": "#a9c46f",
        "pine": "#7fae6a",
        "snow": "#f3e6b6",
        "dim": "#807a5c",
        "night": "#1a1a17",
        "shadow": "#282823",
        "slate": "#3a382f"
      },
      "vending-glow": {
        "brick": "#b8321c",
        "neon": "#ff4b2b",
        "ember": "#ff8a3d",
        "amber": "#ffb547",
        "gold": "#ffd56b",
        "sage": "#d0e08a",
        "moss": "#a6d46c",
        "pine": "#6fc28a",
        "snow": "#fff0c2",
        "dim": "#868063",
        "night": "#161613",
        "shadow": "#24241f",
        "slate": "#36342b"
      },
      "lamplit-glow": {
        "brick": "#96402e",
        "neon": "#d5583d",
        "ember": "#db814c",
        "amber": "#e1b568",
        "gold": "#ecd08f",
        "sage": "#c4c88e",
        "moss": "#a6d46c",
        "pine": "#6fc28a",
        "snow": "#f1e4b5",
        "dim": "#7d7860",
        "night": "#1c1c1a",
        "shadow": "#2a2a28",
        "slate": "#3a3933"
      }
    }
  },
  "blocks": [
    {
      "type": "rprompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "\ue0b6",
          "template": "{{ if .Env.PNPPSHOST }} \uf8c5 {{ .Env.PNPPSHOST }} {{ end }}",
          "foreground": "p:snow",
          "background": "p:brick",
          "type": "text",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{ if .Env.PNPPSSITE }} \uf2dd {{ .Env.PNPPSSITE }}{{ end }}",
          "foreground": "p:night",
          "powerline_symbol": "\ue0b0",
          "background": "p:pine",
          "type": "text",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "trailing_diamond": "\ue0b4",
          "template": "{{ if .Env.PNPPSSITE }}\u00a0{{ end }}",
          "foreground": "p:night",
          "background": "p:pine",
          "type": "text",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "trailing_diamond": "\ue0b0",
          "template": " \uedd9 ",
          "foreground": "p:night",
          "background": "p:ember",
          "type": "text",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " {{ .UserName }} ",
          "foreground": "p:night",
          "background": "p:gold",
          "type": "session",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "max_depth": 3,
            "style": "agnoster_short"
          },
          "template": " {{ .Path }} ",
          "foreground": "p:night",
          "powerline_symbol": "\ue0b0",
          "background": "p:snow",
          "type": "path",
          "style": "powerline"
        },
        {
          "properties": {
            "branch_icon": "",
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .UpstreamIcon }}[\uf126 {{ .HEAD }}] {{.BranchStatus}} {{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }}",
          "foreground": "p:night",
          "powerline_symbol": "\ue0b0",
          "background": "p:moss",
          "type": "git",
          "style": "powerline"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "break",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "style": "dallas",
            "threshold": 0
          },
          "template": " \ueba2 {{ .FormattedMs }}s ",
          "foreground": "p:snow",
          "background": "p:shadow",
          "type": "executiontime",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "time_format": "15:04:05"
          },
          "template": "<transparent> \ue0ba\ue0bc </>{{ .CurrentDate | date .Format }} ",
          "foreground": "p:snow",
          "background": "p:shadow",
          "type": "time",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "time_format": "Monday"
          },
          "template": "<p:dim>|</> {{ .CurrentDate | date .Format }}",
          "foreground": "p:snow",
          "background": "p:shadow",
          "type": "time",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "always",
            "fetch_version": true
          },
          "template": "<p:dim> | </><p:sage>\ue718</> {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "foreground": "p:pine",
          "background": "p:shadow",
          "type": "node",
          "style": "powerline"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "\ue3bf ",
          "foreground": "p:neon",
          "type": "root",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": ">>",
          "foreground": "p:amber",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
